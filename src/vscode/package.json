{
  "name": "gpp",
  "displayName": "G++",
  "description": "G++ language support: highlighting, errors as you type, completion with auto-import, hover, go to definition, signature help, formatting and outline.",
  "version": "0.1.0",
  "publisher": "gpp-lang",
  "icon": "images/icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gpp",
        "aliases": [
          "G++",
          "gpp"
        ],
        "extensions": [
          ".gpp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/gpp-file.png",
          "dark": "./images/gpp-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "gpp",
        "scopeName": "source.gpp",
        "path": "./syntaxes/gpp.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[gpp]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.formatOnSave": true,
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "G++",
      "properties": {
        "gpp.serverPath": {
          "type": "string",
          "default": "gpp",
          "description": "Path to the gpp binary. The extension runs `<serverPath> lsp`."
        }
      }
    },
    "commands": [
      {
        "command": "gpp.restartServer",
        "title": "G++: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/grammar.test.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "vscode:prepublish": "npm run build -- --minify"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
