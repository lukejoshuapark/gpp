{
  "name": "gpp",
  "displayName": "G++",
  "description": "G++ language support: highlighting, errors as you type, completion with auto-import, organize imports, hover, go to definition, find references, rename, signature help, formatting, debugging and outline.",
  "version": "0.2.0",
  "publisher": "gpp-lang",
  "icon": "images/icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gpp",
        "aliases": [
          "G++",
          "gpp"
        ],
        "extensions": [
          ".gpp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/gpp-file.png",
          "dark": "./images/gpp-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "gpp",
        "scopeName": "source.gpp",
        "path": "./syntaxes/gpp.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[gpp]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.formatOnSave": true,
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        }
      }
    },
    "configuration": {
      "title": "G++",
      "properties": {
        "gpp.serverPath": {
          "type": "string",
          "default": "gpp",
          "description": "Path to the gpp binary. The extension runs `<serverPath> lsp`."
        }
      }
    },
    "commands": [
      {
        "command": "gpp.restartServer",
        "title": "G++: Restart Language Server"
      }
    ],
    "breakpoints": [
      {
        "language": "gpp"
      }
    ],
    "debuggers": [
      {
        "type": "gpp",
        "label": "G++",
        "languages": [
          "gpp"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "The package to debug: a directory (or .gpp file). Built with `gpp build` with optimizations off.",
                "default": "${workspaceFolder}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments for the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the program (default: the package directory)."
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the program.",
                "default": {}
              },
              "buildFlags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra flags for gpp build, e.g. [\"-tags=dev\"].",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "gpp",
            "request": "launch",
            "name": "Debug G++ program",
            "program": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "G++: Launch program",
            "description": "Build with gpp and debug with Delve",
            "body": {
              "type": "gpp",
              "request": "launch",
              "name": "Debug G++ program",
              "program": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/grammar.test.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "vscode:prepublish": "npm run build -- --minify"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "activationEvents": [
    "onDebugResolve:gpp",
    "onDebugDynamicConfigurations:gpp"
  ]
}
